    {
      "type": "row",
      "title": "État dans le temps — observer : que s'est-il passé depuis ?",
      "collapsed": false,
      "id": 6,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Interfaces Ethernet — UP / DOWN",
      "description": "Une ligne par interface. Une coupure (make panne) apparaît en rouge, avec son heure. En cas de doute, DOWN l'emporte sur UP.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "0 * max by (device, interface) (gnmic_interfaces_interface_state_oper_status{interface=~\"Ethernet.*\", device=~\"$device\", oper_status!=\"UP\"}) or max by (device, interface) (gnmic_interfaces_interface_state_oper_status{interface=~\"Ethernet.*\", device=~\"$device\", oper_status=\"UP\"})",
          "legendFormat": "{{device}} · {{interface}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.85,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "state-timeline",
      "title": "Sessions BGP — ESTABLISHED / autre",
      "description": "vrf=default : iBGP VPNv4 vers le RR (p1). vrf=VRFA/VRFB : eBGP PE–CE. p2 n'a pas de BGP.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "0 * max by (device, vrf, voisin) (gnmic_network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_state_session_state{device=~\"$device\", session_state!=\"ESTABLISHED\"}) or max by (device, vrf, voisin) (gnmic_network_instances_network_instance_protocols_protocol_bgp_neighbors_neighbor_state_session_state{device=~\"$device\", session_state=\"ESTABLISHED\"})",
          "legendFormat": "{{device}} · {{vrf}} · {{voisin}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ESTABLISHED",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.85,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "type": "row",
      "title": "Performance (P de FCAPS)",
      "collapsed": false,
      "id": 9,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Débit par interface (bit/s) — entrant + sortant",
      "description": "rate(octets) × 8 sur la fenêtre de Grafana. Légende triée par maximum : les interfaces actives en tête.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(gnmic_interfaces_interface_state_counters_in_octets{device=~\"$device\", interface=~\"Ethernet.*\"}[$__rate_interval]) * 8",
          "legendFormat": "{{device}} · {{interface}} ↓",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(gnmic_interfaces_interface_state_counters_out_octets{device=~\"$device\", interface=~\"Ethernet.*\"}[$__rate_interval]) * 8",
          "legendFormat": "{{device}} · {{interface}} ↑",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Erreurs et rejets (paquets/s)",
      "description": "in/out errors + discards. Doit rester à 0 : sinon problème physique ou saturation.",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (device, interface) (rate({__name__=~\"gnmic_interfaces_interface_state_counters_(in|out)_(errors|discards)\", device=~\"$device\", interface=~\"Ethernet.*\"}[$__rate_interval]))",
          "legendFormat": "{{device}} · {{interface}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Paquets unicast reçus (paquets/s)",
      "description": "Le ping de make trafic envoie 5 paquets/s : on le retrouve ici sur chaque interface du chemin.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
