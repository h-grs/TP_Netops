        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "type": "stat",
      "title": "Sessions BGP non établies",
      "description": "toute session BGP qui n'est pas ESTABLISHED (attendu : 0)",
      "id": 5,
      "datasource": {
        "type": "prometheus",
