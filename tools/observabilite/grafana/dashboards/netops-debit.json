{
  "uid": "netops-debit",
  "title": "NetOps — Débit des interfaces",
  "tags": [
    "netops",
    "mpls"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Équipement",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gnmic_interfaces_interface_state_counters_in_octets, device)",
          "refId": "v_device"
        },
        "definition": "label_values(gnmic_interfaces_interface_state_counters_in_octets, device)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gnmic_interfaces_interface_state_counters_in_octets{device=~\"$device\", interface=~\"Ethernet.*\"}, interface)",
          "refId": "v_interface"
        },
        "definition": "label_values(gnmic_interfaces_interface_state_counters_in_octets{device=~\"$device\", interface=~\"Ethernet.*\"}, interface)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Débit entrant (bit/s) — rate(octets reçus) × 8",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{device}} · {{interface}}",
          "expr": "rate(gnmic_interfaces_interface_state_counters_in_octets{device=~\"$device\",interface=~\"$interface\"}[$__rate_interval]) * 8"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Débit sortant (bit/s) — rate(octets émis) × 8",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{device}} · {{interface}}",
          "expr": "rate(gnmic_interfaces_interface_state_counters_out_octets{device=~\"$device\",interface=~\"$interface\"}[$__rate_interval]) * 8"
        }
      ]
    }
  ]
}
