{
  "uid": "netops-debit",
  "title": "NetOps — Débit des interfaces",
  "description": "O3 : débit par équipement et par interface, pour les expériences de chemin et de panne.",
  "tags": [
    "netops",
    "gnmi",
    "O3"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Équipement",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gnmic_interfaces_interface_state_counters_in_octets, device)",
          "refId": "v_device"
        },
        "definition": "label_values(gnmic_interfaces_interface_state_counters_in_octets, device)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(gnmic_interfaces_interface_state_counters_in_octets{device=~\"$device\", interface=~\"Ethernet.*\"}, interface)",
          "refId": "v_interface"
        },
        "definition": "label_values(gnmic_interfaces_interface_state_counters_in_octets{device=~\"$device\", interface=~\"Ethernet.*\"}, interface)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "Ethernet.*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Débit entrant (bit/s) — rate(octets reçus) × 8",
      "description": "Légende à droite, triée par maximum : les interfaces traversées par le trafic de test sont en tête.",
      "id": 1,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(gnmic_interfaces_interface_state_counters_in_octets{device=~\"$device\", interface=~\"$interface\"}[$__rate_interval]) * 8",
          "legendFormat": "{{device}} · {{interface}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Débit sortant (bit/s) — rate(octets émis) × 8",
      "description": "Même lecture que le débit entrant.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(gnmic_interfaces_interface_state_counters_out_octets{device=~\"$device\", interface=~\"$interface\"}[$__rate_interval]) * 8",
          "legendFormat": "{{device}} · {{interface}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
