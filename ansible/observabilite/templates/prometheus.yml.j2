# {{ ansible_managed }}
global:
  scrape_interval: {{ prometheus_scrape_interval }}

scrape_configs:
  - job_name: gnmic
    static_configs:
      - targets: ["{{ lab_vm_address }}:{{ gnmic_prom_port }}"]
    metric_relabel_configs:
      # étiquette lisible dans Grafana : « interface » (gnmic produit « interface_name »)
      - source_labels: [interface_name]
        target_label: interface
